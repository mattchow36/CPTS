command1 | xargs [选项] command2, 把 command1 的输出（按空白/换行分割）作为参数追加到 command2 后面
echo "a.txt b.txt" | xargs rm


手工枚举命令：
ps au                                                                  查看进程，类似 find /proc -name cmdline -exec cat {} \; 2>/dev/null | tr " " "\n"
ps aux
ls /home
ls -la /home/stacey.jenkins/
ls -l ~/.ssh                                                           密钥
history                                                                bash历史
sudo -l                                                                看nopasswd
cat /etc/passwd                                                        用户名:密码:用户 ID (UID):组 ID (GID):用户信息:家目录:登录Shell
cat /etc/passwd | cut -f1 -d:                                          用户名
ls -la /etc/cron.daily/                                                计划任务
lsblk                                                                  看块设备，如硬盘
find / -path /proc -prune -o -type d -perm -o+w 2>/dev/null            查找可写目录
find / -path /proc -prune -o -type f -perm -o+w 2>/dev/null            查找可写文件
whoami                                                                 用户身份
id                                                                     属于哪些组
hostname                                                               服务器名称
ifconfig 或 ip a                                                       子网，额外网卡
cat /etc/os-release                                                    操作系统
echo $PATH                                                             路径环境变量
env                                                                    所有环境变量
uname -a 或 cat /proc/version                                          内核
lscpu                                                                  cpu信息
cat /etc/shells                                                        可用登录shell
lpstat                                                                 查找打印机
cat /etc/fstab                                                         文件挂载配置
route 或 netstat -rn                                                   路由表
arp -a                                                                 arp表
cat /etc/group                                                         组信息
getent group sudo                                                      查看sudo组，同时覆盖本地文件和网络目录
df -h                                                                  已挂载磁盘的空间
cat /etc/fstab | grep -v "#" | column -t                               未挂载的文件系统
find / -type f -name ".*" -exec ls -l {} \; 2>/dev/null | grep htb-student              隐藏文件
find / -type d -name ".*" -ls 2>/dev/null                                               隐藏目录
ls -l /tmp /var/tmp /dev/shm                                                            临时文件

find / -name "*.sh" 2>/dev/null | xargs cat | grep "HTB"                从 / 开始找 .sh 文件，打印给cat，只显示包含'HTB'的行

lastlog            最后登录

apt list --installed | tr "/" " " | cut -d" " -f1,3 | sed 's/[0-9]://g' | tee -a installed_pkgs.list            已安装的软件包


ls -l /bin /usr/bin/ /usr/sbin/            二进制文件
https://gtfobins.org/                      可提权二进制文件
for i in $(curl -s https://gtfobins.org/api.json | jq -r '.executables | keys[]'); do if grep -q "$i" installed_pkgs.list; then echo "Check for GTFO: $i";fi; done      匹配已安装二进制文件


strace ping -c1 10.129.112.20            跟踪 ping 的系统调用


find / -type f \( -name *.conf -o -name *.config \) -exec ls -l {} \; 2>/dev/null      找 .config
find / ! -path "*/proc/*" -iname "*config*" -type f 2>/dev/null                        找 config.*
cat /var/www/html/wp-config.php | grep "DB_PASSWORD"                                   搜索单文件内凭证

find / -type f -name "*.sh" 2>/dev/null | grep -v "src\|snap\|share"                   找 .sh


