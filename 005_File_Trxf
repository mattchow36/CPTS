PS C:\htb> [Convert]::ToBase64String((Get-Content -path "C:\Windows\system32\drivers\etc\hosts" -Encoding byte))                                      在目标编码 hosts
nc -lvnp 8000                                                                                                                                         在攻击机接收 哈希
PS C:\htb> Get-FileHash "C:\Windows\system32\drivers\etc\hosts" -Algorithm MD5 | select Hash      读 hosts 的哈希
echo <base64> | base64 -d -w 0 > hosts                                                            在攻击机解码
md5sum hosts                                                                                      核对哈希






